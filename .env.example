# Environment variables for eyeMEI
# Copy this file to .env and configure as needed

# Flask environment (production/development)
FLASK_ENV=production

# Gunicorn workers (adjust based on CPU cores)
# Recommended: (2 x CPU cores) + 1
GUNICORN_WORKERS=4

# Gunicorn timeout (in seconds)
GUNICORN_TIMEOUT=120

# Application ports
MAIN_APP_PORT=5000
ADMIN_PANEL_PORT=5001
